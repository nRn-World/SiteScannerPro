# SiteScanner Pro - Miljövariabler
# Kopiera denna fil till ".env" och fyll i dina egna värden.

# KOFI_PRO_URL: Länken användaren skickas till när de köper Pro.
# Använd din Ko-fi-shop/länk. Om du skapar en specifik produkt, lägg produktlänken här.
KOFI_PRO_URL="https://ko-fi.com/s/b525e21531"

# Hemliga värden. Ange dem endast i Render, aldrig i GitHub.
KOFI_LICENSE_KEY_HASH=""
LICENSE_SIGNING_SECRET=""

# APP_URL: Adressen där appen körs.
# Används för absoluta länkar och lokalt dev-läge.
APP_URL="http://localhost:3000"

# VIP: skapa länkar ENDAST lokalt (VIP-knapp syns bara på localhost).
# VIP_ADMIN_SECRET: minst 4 tecken, bara i lokal .env – aldrig i git/Render.
VIP_ADMIN_SECRET=""
# Delningslänkar pekar alltid på livesajten (vänner öppnar denna URL).
VIP_SHARE_BASE_URL="https://nrnworld.one/SiteScannerPro/"
# Viktigt: samma LICENSE_SIGNING_SECRET lokalt som på Render, annars funkar inte länkarna online.

# Valfritt - kontaktformulär (Gmail med app-lösenord):
# EMAIL_USER="din-email@gmail.com"
# EMAIL_PASS="ditt-app-losenord"
# CONTACT_RECEIVER_EMAIL="mottagare@gmail.com"
