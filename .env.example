# SiteScanner Pro - Miljövariabler
# Kopiera denna fil till ".env" och fyll i dina egna värden.

# LICENSE_SIGNING_SECRET: hemlighet för att signera delbara rapportlänkar.
# Minst 32 slumpade tecken. Ange endast i Render, aldrig i GitHub.
LICENSE_SIGNING_SECRET=""

# APP_URL: Adressen där appen körs.
# Används för absoluta länkar och lokalt dev-läge.
APP_URL="http://localhost:3000"

# DATA_DIR: Beständig lagring (Render: monterad disk, t.ex. /var/data/sitescanner).
# Lokalt behövs den inte – då används projektets data/-katalog.
# DATA_DIR="/var/data/sitescanner"

# FAS 1.4/5.2: prestanda- och säkerhetsgränser
LOG_LEVEL="info"
MAX_CONCURRENT_SCANS="2"
MAX_CONCURRENT_PAGES="2"

# FAS 3.1: hur länge delbara rapportlänkar lever (dagar, 1-365)
REPORT_SHARE_TTL_DAYS="30"

# Hur länge en identisk URL återanvänder senaste skanningen (sekunder, 0 = av)
SCAN_CACHE_TTL_SECONDS="900"

# Sätt till 1 för att hoppa över annoterade issue-skärmdumpar (sparar minne)
# LOW_MEMORY="1"

# VITE_REPORT_BASE: var sparade rapportlänkar ska bo (valfritt, standard = VITE_API_BASE)
# VITE_REPORT_BASE="https://sitescanner-pro.onrender.com"

# Viktigt: samma LICENSE_SIGNING_SECRET lokalt som på Render, annars funkar inte delningslänkarna online.

# Valfritt - kontaktformulär (Gmail med app-lösenord):
# EMAIL_USER="din-email@gmail.com"
# EMAIL_PASS="ditt-app-lösenord"
# CONTACT_RECEIVER_EMAIL="mottagare@gmail.com"

# VITALS_API_KEY: Aktiverar Core Web Vitals (valfritt).
# VITALS_API_KEY="AIza..."
